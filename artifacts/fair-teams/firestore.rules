rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    function canEditResource() {
      return signedIn()
        && request.auth.uid in resource.data.get("memberUids", [])
        && (
          resource.data.get("roleByUid", {}).get(request.auth.uid, "")
            in ["owner", "editor", "organizer"]
          ||
          (
            resource.data.get("ownerUid", "") == request.auth.uid
            && resource.data.get("roleByUid", {}).get(request.auth.uid, "") == ""
          )
        );
    }

    // Ordinary organizer edits may change shared content and display-name
    // metadata, but invitation and membership state is server-controlled.
    function organizerUpdateKeepsGovernance() {
      return canEditResource()
        && request.resource.data.get("ownerUid", "") == resource.data.get("ownerUid", "")
        && request.resource.data.get("ownerEmail", "") == resource.data.get("ownerEmail", "")
        && request.resource.data.get("memberUids", []) == resource.data.get("memberUids", [])
        && request.resource.data.get("memberEmails", []) == resource.data.get("memberEmails", [])
        && request.resource.data.get("pendingInviteEmails", []) == resource.data.get("pendingInviteEmails", [])
        && request.resource.data.get("roleByUid", {}) == resource.data.get("roleByUid", {})
        && request.resource.data.get("memberUidByEmail", {}) == resource.data.get("memberUidByEmail", {})
        && request.resource.data.get("organizerJoinedAtByUid", {})
          == resource.data.get("organizerJoinedAtByUid", {})
        && request.resource.data.get("organizerGovernanceEligibleAtByUid", {})
          == resource.data.get("organizerGovernanceEligibleAtByUid", {});
    }

    // An organizer may remove only their own access and matching stale pending
    // invitation. Another organizer must remain afterward. Removal of somebody
    // else requires the later vote flow.
    function validOrganizerSelfLeave() {
      return canEditResource()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "memberUids",
          "memberEmails",
          "pendingInviteEmails",
          "roleByUid",
          "memberNamesByUid",
          "memberNamesByEmail",
          "memberUidByEmail",
          "organizerJoinedAtByUid",
          "organizerGovernanceEligibleAtByUid",
          "updatedAt",
          "updatedAtIso"
        ])
        && request.resource.data.get("ownerUid", "") == resource.data.get("ownerUid", "")
        && request.resource.data.get("ownerEmail", "") == resource.data.get("ownerEmail", "")
        && request.resource.data.get("memberUids", []).toSet()
          == resource.data.get("memberUids", []).toSet().difference([request.auth.uid].toSet())
        && request.resource.data.get("memberEmails", []).toSet()
          == resource.data.get("memberEmails", []).toSet().difference([signedInEmail()].toSet())
        && request.resource.data.get("pendingInviteEmails", []).toSet()
          == resource.data.get("pendingInviteEmails", []).toSet()
            .difference([signedInEmail()].toSet())
        && request.resource.data.get("roleByUid", {})
          .diff(resource.data.get("roleByUid", {}))
          .affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in request.resource.data.get("roleByUid", {}))
        && request.resource.data.get("memberUidByEmail", {})
          .diff(resource.data.get("memberUidByEmail", {}))
          .affectedKeys().hasOnly([signedInEmail()])
        && !(signedInEmail() in request.resource.data.get("memberUidByEmail", {}))
        && request.resource.data.get("memberNamesByUid", {})
          .diff(resource.data.get("memberNamesByUid", {}))
          .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get("memberNamesByEmail", {})
          .diff(resource.data.get("memberNamesByEmail", {}))
          .affectedKeys().hasOnly([signedInEmail()])
        && request.resource.data.get("organizerJoinedAtByUid", {})
          .diff(resource.data.get("organizerJoinedAtByUid", {}))
          .affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in request.resource.data.get("organizerJoinedAtByUid", {}))
        && request.resource.data.get("organizerGovernanceEligibleAtByUid", {})
          .diff(resource.data.get("organizerGovernanceEligibleAtByUid", {}))
          .affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in request.resource.data.get("organizerGovernanceEligibleAtByUid", {}))
        && (
          request.resource.data.get("roleByUid", {}).values()
            .hasAny(["owner", "editor", "organizer"])
          ||
          (
            request.resource.data.get("ownerUid", "")
              in request.resource.data.get("memberUids", [])
          )
        );
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/sharedGroups/$(groupId);
    }

    function rosterPath(rosterId) {
      return /databases/$(database)/documents/sharedRosters/$(rosterId);
    }

    function isGroupMemberById(groupId) {
      return signedIn()
        && exists(groupPath(groupId))
        && request.auth.uid in get(groupPath(groupId)).data.memberUids;
    }

    function canEditGroupById(groupId) {
      return isGroupMemberById(groupId)
        && (
          get(groupPath(groupId)).data.get("roleByUid", {}).get(request.auth.uid, "")
            in ["owner", "editor", "organizer"]
          ||
          (
            get(groupPath(groupId)).data.get("ownerUid", "") == request.auth.uid
            && get(groupPath(groupId)).data.get("roleByUid", {}).get(request.auth.uid, "") == ""
          )
        );
    }

    function isRosterMemberById(rosterId) {
      return signedIn()
        && exists(rosterPath(rosterId))
        && request.auth.uid in get(rosterPath(rosterId)).data.memberUids;
    }

    function canEditRosterById(rosterId) {
      return isRosterMemberById(rosterId)
        && (
          get(rosterPath(rosterId)).data.get("roleByUid", {}).get(request.auth.uid, "")
            in ["owner", "editor", "organizer"]
          ||
          (
            get(rosterPath(rosterId)).data.get("ownerUid", "") == request.auth.uid
            && get(rosterPath(rosterId)).data.get("roleByUid", {}).get(request.auth.uid, "") == ""
          )
        );
    }

    function validClubRatingSummary(rosterId, playerId) {
      return isRosterMemberById(rosterId)
        && request.resource.data.rosterId == rosterId
        && request.resource.data.playerId == playerId
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 0
        && request.resource.data.ratingSum is number
        && request.resource.data.ratingSum >= 0
        && (
          request.resource.data.averageSkill == null
          ||
          (
            request.resource.data.averageSkill is number
            && request.resource.data.averageSkill >= 1
            && request.resource.data.averageSkill <= 10
          )
        );
    }

    function validOwnClubRatingSubmission(rosterId) {
      return isRosterMemberById(rosterId)
        && request.resource.data.rosterId == rosterId
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.skipped is bool
        && (
          (
            request.resource.data.skipped == true
            && request.resource.data.skill == null
          )
          ||
          (
            request.resource.data.skipped == false
            && request.resource.data.skill is number
            && request.resource.data.skill >= 1
            && request.resource.data.skill <= 10
          )
        );
    }

    function validClubNote(rosterId) {
      return isRosterMemberById(rosterId)
        && request.resource.data.rosterId == rosterId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 160;
    }

    // Workspace invitation records and their deduplication controls contain
    // private recipient and delivery metadata. Clients use trusted callable
    // functions for organizer lists and sanitized recipient context instead.
    match /sharedWorkspaceInvitations/{invitationId} {
      allow read, write: if false;
    }

    function validInitialRosterPendingInvites() {
      let groupId = request.resource.data.get("groupId", "");
      return groupId == ""
        ? request.resource.data.get("pendingInviteEmails", []).size() == 0
        : (
          exists(groupPath(groupId))
          && request.auth.uid in get(groupPath(groupId)).data.get("memberUids", [])
          && request.resource.data.get("pendingInviteEmails", [])
            == get(groupPath(groupId)).data.get("pendingInviteEmails", [])
        );
    }

    match /sharedWorkspaceInvitationLocks/{lockId} {
      allow read, write: if false;
    }

    match /authEmailVerificationThrottles/{uid} {
      allow read, write: if false;
    }

    // Trusted workspace closure uses a short-lived Admin SDK cleanup checkpoint.
    // It is never client-readable or client-writable.
    match /sharedWorkspaceClosures/{closureId} {
      allow read, write: if false;
    }

    match /sharedGroups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.get("pendingInviteEmails", []).size() == 0;

      allow read: if signedIn()
        && request.auth.uid in resource.data.memberUids;

      allow update: if organizerUpdateKeepsGovernance()
        || validOrganizerSelfLeave();

      // Workspace closure will use a governed flow; ordinary clients cannot delete it.
      allow delete: if false;

      // Organizer-removal proposals expose aggregate governance state only.
      // Active organizers may query them. A removed target may fetch the
      // specific proposal naming them, but cannot list workspace history.
      // All proposal mutations are performed by trusted callable functions.
      match /organizerRemovalProposals/{proposalId} {
        allow get: if canEditGroupById(groupId)
          || (
            signedIn()
            && resource.data.get("targetUid", "") == request.auth.uid
          );
        allow list: if canEditGroupById(groupId);
        allow create, update, delete: if false;
      }

      // Electorate snapshots, active-proposal control and individual ballots
      // are server-only. In particular, organizers cannot read even their own
      // ballot document, which prevents document paths from exposing voters.
      match /organizerRemovalPrivate/{proposalId} {
        allow read, write: if false;

        match /ballots/{voterUid} {
          allow read, write: if false;
        }
      }

      match /organizerRemovalControl/{controlDoc} {
        allow read, write: if false;
      }

      match /equipmentBags/{bagId} {
        allow read: if isGroupMemberById(groupId);
        allow create, update, delete: if canEditGroupById(groupId);
      }

      // Fair Teams v1.50 Tasks Board
      match /taskBoard/{boardDoc} {
        allow read: if isGroupMemberById(groupId);
        allow create, update, delete: if canEditGroupById(groupId);

        match /columns/{columnId} {
          allow read: if isGroupMemberById(groupId);
          allow create, update, delete: if canEditGroupById(groupId);
        }

        match /cards/{cardId} {
          allow read: if isGroupMemberById(groupId);
          allow create, update, delete: if canEditGroupById(groupId);
        }
      }
    }

    match /sharedRosters/{rosterId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && validInitialRosterPendingInvites();

      allow read: if signedIn()
        && request.auth.uid in resource.data.memberUids;

      allow update: if organizerUpdateKeepsGovernance()
        || validOrganizerSelfLeave();

      // Workspace closure will use a governed flow; ordinary clients cannot delete it.
      allow delete: if false;

      match /equipmentBags/{bagId} {
        allow read: if isRosterMemberById(rosterId);
        allow create, update, delete: if canEditRosterById(rosterId);
      }

      // Fair Teams v1.50 Tasks Board
      match /taskBoard/{boardDoc} {
        allow read: if isRosterMemberById(rosterId);
        allow create, update, delete: if canEditRosterById(rosterId);

        match /columns/{columnId} {
          allow read: if isRosterMemberById(rosterId);
          allow create, update, delete: if canEditRosterById(rosterId);
        }

        match /cards/{cardId} {
          allow read: if isRosterMemberById(rosterId);
          allow create, update, delete: if canEditRosterById(rosterId);
        }
      }

      // Fair Teams v1.56 Club Attendance
      match /attendanceIssues/{issueId} {
        allow read: if isRosterMemberById(rosterId);

        allow create, update, delete: if canEditRosterById(rosterId);
      }

      match /clubRatingSummaries/{playerId} {
        // Club average is visible to roster members.
        allow read: if isRosterMemberById(rosterId);

        // Testing version: client updates the aggregate summary.
        // Later production version should move this to a Cloud Function.
        allow create, update: if validClubRatingSummary(rosterId, playerId);

        allow delete: if false;
      }

      match /clubRatingSubmissions/{submissionId} {
        // Allows the app transaction to read the user's own rating document,
        // even before it exists. App document IDs are expected to start with:
        // request.auth.uid + "_"
        allow get: if isRosterMemberById(rosterId)
          && submissionId.matches(request.auth.uid + "_.*");

        // For existing own rating documents only.
        // Individual ratings stay private.
        allow list: if isRosterMemberById(rosterId)
          && resource.data.userUid == request.auth.uid;

        allow create: if validOwnClubRatingSubmission(rosterId)
          && submissionId.matches(request.auth.uid + "_.*");

        allow update: if validOwnClubRatingSubmission(rosterId)
          && resource.data.userUid == request.auth.uid
          && submissionId.matches(request.auth.uid + "_.*");

        allow delete: if false;
      }

      // Stripes shared file/resource library
      match /resources/{resourceId} {
        allow read: if isRosterMemberById(rosterId);

        allow create: if canEditRosterById(rosterId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.type in [
            "stripe_file",
            "google_drive",
            "external_link"
          ];

        allow update, delete: if canEditRosterById(rosterId);
      }

      match /clubNotes/{noteId} {
        // Shared post-it notes are visible to all organizers in the roster.
        allow read: if isRosterMemberById(rosterId);

        allow create: if validClubNote(rosterId);

        // Organizers can remove only their own notes.
        allow delete: if isRosterMemberById(rosterId)
          && resource.data.createdByUid == request.auth.uid;

        allow update: if false;
      }
    }
  }
}
